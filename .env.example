# Copy to .env and fill in. Never commit the real .env file.
#
# Generate POSTGRES_PASSWORD / JWT_SECRET / ANON_KEY / SERVICE_ROLE_KEY with:
#   node scripts/generate-keys.mjs

# --- Postgres / JWT -----------------------------------------------------
POSTGRES_PASSWORD=
JWT_SECRET=
ANON_KEY=
SERVICE_ROLE_KEY=

# --- URLs -----------------------------------------------------------------
# Host port the app container publishes. Change if 3000 is already taken.
APP_PORT=3000
# Public address the app is reached at (browser-facing). Use your real
# https:// domain once this is behind a reverse proxy — see README.
SITE_URL=http://lab-docs.local:3000
# Address GoTrue uses when building links (autoconfirm is on, so this is
# rarely hit, but it must still be set). Kong is loopback-only — this stays
# a local reference URL, not something exposed to the LAN.
SUPABASE_PUBLIC_URL=http://localhost:8000

# --- Optional SMTP (leave blank to keep GOTRUE_MAILER_AUTOCONFIRM behavior) --
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# --- App runtime (server-side only — never prefixed with NEXT_PUBLIC_) ----
# In docker-compose these are wired automatically from the values above;
# set them here too for running `npm run dev` outside Docker against a
# `supabase start` (Supabase CLI) local stack.
SUPABASE_URL=http://localhost:8000
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
